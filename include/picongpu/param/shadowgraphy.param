    namespace plugins
    {
        namespace shadowgraphy
        {
            namespace params
            {
                // The time integration part of the plugin will be called each t_res'ed step
                // until t_res * t_n steps after the start of the integration in the .cfg file

                // Make sure that the Nyquist-Shannon theorem is fulfilled
                //     t_res * dt * c < lambda_probe / 2
                constexpr unsigned int t_res = 2;

                // Make sure that the Time-Bandwidth product is fulfilled @TODO
                //     omega_n = t_n
                //     domega = 2pi / (t_res * dt)
                //     domega * omega_n * fwhm_probe[t] / 2 pi > 0.441 (for gauss)
                constexpr unsigned int t_n = 560 - 100;//128

                //constexpr unsigned int omega_n = 128; //t_n / t_res; // should probably be an even number
                //constexpr unsigned int omega_n = tn / t_res; //t_n / t_res; // should probably be an even number
                constexpr unsigned int omega_n = 256;

                constexpr unsigned int x_n = 128;
                constexpr unsigned int y_n = 128;

                // Transverse resolution of shadowgram in PIConGPU cell size units
                constexpr unsigned int x_res = 1;//2
                constexpr unsigned int y_res = 1;//4

                // Propagation distance in SI
                constexpr float delta_z = 10e-6;

                // Values for frequency filter to extract probe laser better in m
                // Make sure to respect the time bandwidth limit
                constexpr float_64 min_lambda = 660e-9 - 0.0*100e-9;
                constexpr float_64 max_lambda = 840e-9 + 0.0*100e-9;

                // There is a sinusoidal slope from min_lambda - d_lambda_wf to min_lambda and from max_lambda to max_lambda + d_lambda_wf
                constexpr float_64 d_lambda_wf = 100e-9;
            }


            namespace fourierhelper
            {   
                HINLINE float_64 omega(int i){
                    //return 2 * PI  * (i - params::omega_n / 2.0) / params::omega_n / params::t_res / SI::DELTA_T_SI;
                    //float_64 omega_step = 4.0 * PI * SI::SPEED_OF_LIGHT_SI * (1 / params::min_lambda - 1 / params::max_lambda);
                    float_64 const omega_max = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / (params::min_lambda - params::d_lambda_wf);
                    float_64 const omega_min = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / (params::max_lambda + params::d_lambda_wf);
                    
                    // -1 if you want to include omega_max
                    float_64 const omega_step = (omega_max - omega_min) / (float_64(params::omega_n - 1));
                    
                    //return omega_min + i * omega_step;
                    /**if(i < params::omega_n / 2){
                        return -omega_max + i * omega_step;
                    } else {
                        return omega_max - (params::omega_n - i + 1) * omega_step;//-omega_min + (i - params::omega_n / 2.0) * omega_step;
                    }**/
                    return omega_min + i * omega_step;
                }

                HINLINE float_64 get_omega_step(){
                    float_64 const omega_max = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / (params::min_lambda - params::d_lambda_wf);
                    float_64 const omega_min = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / (params::max_lambda + params::d_lambda_wf);
                    
                    // -1 if you want to include omega_max
                    return (omega_max - omega_min) / (float_64(params::omega_n - 1));

                }

