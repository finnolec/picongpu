                    return 2 * PI * float_64(i - params::omega_n) / float_64(params::omega_n) / (params::t_res * SI::DELTA_T_SI);
                }*/

                // kx so that it is the proper kx for FFTs
                HINLINE float_64 kx(int i){ // @TODO x_n
                    return 2 * PI  * (i - shadowgraphy::params::x_n / 2.0) / shadowgraphy::params::x_n / shadowgraphy::params::x_res / SI::CELL_WIDTH_SI;
                }

                // ky so that it is the proper ky for FFTs
                HINLINE float_64 ky(int i){ // @TODO y_n
                    return 2 * PI  * (i - shadowgraphy::params::y_n / 2.0) / shadowgraphy::params::y_n / shadowgraphy::params::y_res / SI::CELL_HEIGHT_SI;
                }
            }


            namespace masks
            {
                // Numerical aperture to remove e.g. side scattered light from probe laser and drive laser from shadowgraphy simulations
                constexpr float_64 numerical_aperture = 0.23;



                HINLINE float_64 frequency_filter(int o){
                    /**
                      * o is integer for omega coordinate from 0 to n_omega
                      */
                    //float_64 const max_omega = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / params::min_lambda;
                    //float_64 const min_omega = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / params::max_lambda;
                    float_64 const omega = math::abs(fourierhelper::omega(o));

                    if(params::d_lambda_wf == 0.0)
                    {
                        float_64 const omega_max = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / params::min_lambda;
                        float_64 const omega_min = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / params::max_lambda;

                        //std::cout << "1: " << math::abs(fourierhelper::omega(o)) << " -- 2: " << max_omega << std::endl;
                        //std::cout << "3: " << math::abs(fourierhelper::omega(o)) << " -- 4: " << min_omega << std::endl;
                        
                        if( omega >= omega_min && omega <= omega_max ){
                            //std::cout << "a";
                            return 1.0;
                        } else {
                            return 0.0;
                        }

                    } else {
                        float_64 const omega_max_wf = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / (params::min_lambda - params::d_lambda_wf);
                        float_64 const omega_max = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / params::min_lambda;
                        float_64 const d_omega_max = omega_max_wf - omega_max;

                        float_64 const omega_min_wf = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / (params::max_lambda + params::d_lambda_wf);
                        float_64 const omega_min = 2.0 * PI * SI::SPEED_OF_LIGHT_SI / params::max_lambda;
                        float_64 const d_omega_min = omega_min - omega_min_wf;
                        //std::cout << "1: " << math::abs(fourierhelper::omega(o)) << " -- 2: " << max_omega << std::endl;
                        //std::cout << "3: " << math::abs(fourierhelper::omega(o)) << " -- 4: " << min_omega << std::endl;
                        
                        if( omega >= omega_min_wf && omega < omega_min ){
                            return 1.0 - math::cos(PI * (omega - omega_min + d_omega_min) / d_omega_min) / 2.0;
                        } else if ( omega >= omega_min && omega < omega_max ) {
                            return 1.0;
                        } else if ( omega >= omega_max && omega <= omega_max_wf ) {
                            return math::cos(PI * (omega - omega_max) / d_omega_max) / 2.0 + 0.5;
                        } else {
                            return 0.0;
                        }
                    }
                }

                HINLINE float_64 mask(int i, int j, int o){
                    /** 
                      * i is integer for x coordinate from 0 to n_x
                      * j is integer for j coordinate from 0 to n_y
                      * o is integer for omega coordinate from 0 to n_omega
                      */
                    return frequency_filter(o);// * numerical_aperture(i, j, o);
                }
            }
            // The amount of cells to remove from each (!) side of the simulation box
            // This is necessary to remove the boundary artifacts from the PIConGPU simulation
            // constexpr unsigned int x_gap = 16;
            // constexpr unsigned int y_gap = 16;

        }
    }
